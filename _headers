/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=3600

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/og-card.jpg
  Cache-Control: public, max-age=31536000, immutable

# Browser-side encrypted messages. connect-src 'none' is the load-bearing part:
# it is what stops the page being able to send the message anywhere, and it is
# why this page carries no analytics. Duplicated from netlify.toml on purpose,
# same as the two blocks below. Change one, change the other.
/secret
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer

/secret.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer

# The private thread. These duplicate netlify.toml on purpose -- the two files
# agree so that whichever one wins a conflict, the page is still noindex and
# still uncached. Change one, change the other.
/jesse
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer

/jesse.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer

/api/jesse/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, no-cache, must-revalidate, private
  Referrer-Policy: no-referrer

# Never let the service worker be cached for a year like other .js files, or a
# bad one could never be replaced. Mirrors netlify.toml deliberately.
/jesse-sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /
  X-Robots-Tag: noindex, nofollow

# The second private thread. Mirrors the /jesse rules exactly; the two share no
# storage, no session and no keys.
/nicole
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer

/nicole.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer

/api/nicole/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, no-cache, must-revalidate, private
  Referrer-Policy: no-referrer

/nicole-sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /
  X-Robots-Tag: noindex, nofollow

/og-working-with-claude-card.jpg
  Cache-Control: public, max-age=31536000, immutable
