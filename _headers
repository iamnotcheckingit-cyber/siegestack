# WHAT THIS FILE MIRRORS, AND WHAT IT DELIBERATELY DOES NOT
#
# The /secret, /jesse and /nicole blocks below are duplicated from netlify.toml
# on purpose: they agree so that whichever file wins a conflict, those pages are
# still noindex and still uncached. Those blocks say so individually.
#
# ASSET CACHING IS NOT MIRRORED. netlify.toml carries /*.js and /*.css rules
# that this file has no equivalent for, and that asymmetry is intentional --
# do not "fix" it by adding /*.js here. A /*.js rule in this file would put
# jesse-sw.js and nicole-sw.js in scope, and a service worker cached for a year
# cannot be replaced by deploying: the browser keeps running the old one. They
# are saved today by their own more-specific rules, and there is no reason to
# add a broad rule that they then have to be saved from.
#
# Verified live 2026-08-16: consultant-form.js is immutable, jesse-sw.js and
# nicole-sw.js are no-cache,must-revalidate. The split behaves as intended.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Cache-Control: public, max-age=3600

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=31536000, immutable

/og-card.jpg
  Cache-Control: public, max-age=31536000, immutable

# Browser-side encrypted messages. connect-src 'none' is the load-bearing part:
# it is what stops the page being able to send the message anywhere, and it is
# why this page carries no analytics. Duplicated from netlify.toml on purpose,
# same as the two blocks below. Change one, change the other.
/secret
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer

/secret.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; object-src 'none'
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer

# The private thread. These duplicate netlify.toml on purpose -- the two files
# agree so that whichever one wins a conflict, the page is still noindex and
# still uncached. Change one, change the other.
/jesse
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer

/jesse.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer

/api/jesse/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, no-cache, must-revalidate, private
  Referrer-Policy: no-referrer

# Never let the service worker be cached for a year like other .js files, or a
# bad one could never be replaced. Mirrors netlify.toml deliberately.
/jesse-sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /
  X-Robots-Tag: noindex, nofollow

# The second private thread. Mirrors the /jesse rules exactly; the two share no
# storage, no session and no keys.
/nicole
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer

/nicole.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
  Cache-Control: no-store, must-revalidate
  Referrer-Policy: no-referrer

/api/nicole/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store, no-cache, must-revalidate, private
  Referrer-Policy: no-referrer

/nicole-sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /
  X-Robots-Tag: noindex, nofollow

/og-working-with-claude-card.jpg
  Cache-Control: public, max-age=31536000, immutable
